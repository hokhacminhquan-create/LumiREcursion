{
  "name": "lumi-recursion",
  "version": "1.0.0",
  "description": "Lumi:REcursion — Scene reasoning, turn-bound card system & parallel card evaluation for Lumiverse",
  "type": "module",
  "scripts": {
    "build": "bun run build:backend && bun run build:frontend",
    "build:backend": "bun build ./src/backend.ts --outfile ./dist/backend.js --target bun",
    "build:frontend": "bun build ./src/frontend.ts --outfile ./dist/frontend.js --target browser --format esm",
    "sync": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/sync-lumiverse.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.6.2"
  },
  "license": "MIT"
}
